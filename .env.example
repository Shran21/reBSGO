# --- launcher (1) ---
# The launcher's file check: where the generated client file list lives
# (tools/gen_launcher_manifests.py writes it), and the client folder the
# door serves the actual files from. Unset = the door serves no list and
# the launcher simply skips the check.
#REBSGO_LAUNCHER_MANIFEST_DIR=../reBSGO-Launcher/listak    # string
#REBSGO_LAUNCHER_CLIENT_DIR=    # string, the client folder (…/client/live)

# --- net (7) ---
#REBSGO_NET_ADMISSION_PORT=27051    # int
#REBSGO_NET_BACKLOG=30    # int
# GAME_CHAT_ADDRESS in .env is the legacy name for the chat address below;
# either spelling reaches the same setting, the new one wins when both exist.
#REBSGO_NET_CHAT_ADDRESS=127.0.0.1    # string, the chat address handed to clients (loopback swaps for the reached address)
#REBSGO_NET_CHAT_CLIENT_PORT=9338    # int
#REBSGO_NET_CHAT_PORT=0    # int
#REBSGO_NET_GAME_PORT=27050    # int
#REBSGO_NET_MAX_PILOTS=150    # int


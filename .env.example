# github.com/Shran21
# reBSGO server settings.
#
# Every line here is commented out and shows the value the server uses when
# the setting is absent - so this file is a catalogue of what CAN be set,
# not a second place where things ARE set. The live settings are in `.env`
# beside it; copy across only the lines you actually want to change.
#
# Three sorts of thing live in three different places, and it is worth
# keeping them apart:
#
#   .env                 how this machine runs the server - ports, paths,
#                        thread counts, how loud the journal is
#   GameData/templates/  how the GAME behaves - loot holds, mine warheads,
#                        capital command, which sectors are home
#   GameData/cards/      what exists in the game at all - ships, items, stars
#
# A number that changes the game belongs in a template, not here.
#
# Areas below, in order: admission, debris, diagnostics, gamedata, guardrails,
# idle, native, launcher, net, pilot, profile, sector, sender, sqlite.

# --- logging ---
#REBSGO_LOG=info                 # debug | info | warning | error
#REBSGO_LOG_DIR=logs             # where server.log is written
# Any one area can be quieted on its own; the sector area is by far the
# most talkative (four fifths of all lines on a busy server).
#REBSGO_LOG_SECTOR=warning       # boot | sector | wire | pilot | world | admission | chat

# --- admission (3) ---
#REBSGO_ADMISSION_KNOWN_CLIENT_BUILDS=    # set_string, the builds seen so far
#REBSGO_ADMISSION_IGNORE_CLIENT_BUILD=true    # bool, true = do not even report it
#REBSGO_ADMISSION_REGISTRATION_OPEN=    # bool, false closes the door's /register address (open by default)

# --- debris (1) ---
#REBSGO_DEBRIS_FIELD_RANDOM=False    # bool

# --- diagnostics (1) ---
#BSGO_CARRIER_TRANSPONDER_DEBUG=False    # bool, verbose carrier/base-mode transponder tracing in the journal

